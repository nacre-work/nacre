# Full reference: docs/config.md
NACRE_ENV=development
NACRE_CANONICAL_URL=http://localhost:8080

NACRE_PG_URL=postgres://nacre:nacre@localhost:5432/nacre
NACRE_QDRANT_URL=http://localhost:6333
NACRE_REDIS_URL=redis://localhost:6379/0

NACRE_S3_ENDPOINT=http://localhost:9000
NACRE_S3_BUCKET=nacre
NACRE_S3_ACCESS_KEY=minioadmin
NACRE_S3_SECRET_KEY=minioadmin
NACRE_S3_FORCE_PATH_STYLE=true

NACRE_DEFAULT_EMBEDDING_ENDPOINT=http://localhost:8081
NACRE_DEFAULT_EMBEDDING_MODEL=bge-m3
NACRE_DEFAULT_EMBEDDING_DIM=1024
NACRE_PARSER_ENDPOINT=http://localhost:8090

NACRE_JWT_PRIVATE_KEY_REF=file://./dev-jwt.pem
NACRE_ACL_CACHE_TTL=60
NACRE_ACL_PROPAGATION_SLA=60
