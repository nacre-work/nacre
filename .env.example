# Nacre — development configuration. Copy to `.env`.
#
# Full reference, including every variable not listed here: docs/config.md
#
# Hostnames are Compose service names: this file is loaded *into* the
# containers, so `localhost` here means the container itself. Running the
# processes directly on your machine instead? Use localhost and the ports
# Compose publishes.
#
# Nothing here is a real credential.
#
#   docker compose --profile minimal up -d
#
# As it ships every process starts. One thing is left to choose before you can
# create an organization: an embedder, under "Embeddings" below. `init` refuses
# by name until you do.
#
# That command is the same on every platform, an M-series Mac included: the two
# keys that used to need an overlay are in `docker-compose.yml` unconditionally
# and are inert where they are not needed. Do not set `COMPOSE_FILE` — see
# "Local overrides" in docs/config.md for what naming it turns off.


# ── Addresses ────────────────────────────────────────────────────────────────

NACRE_ENV=development

# The front door: the console, the API, the OAuth endpoints and MCP are all
# served from this one origin by the `web` service. `localhost` is right only
# while everything using it is on this machine — put the LAN or VPN address here
# if anything else has to reach the stack.
NACRE_CANONICAL_URL=http://localhost:8082

# Host-side ports Compose publishes. Read by Compose, never by the product; the
# ports inside the network are unaffected. Set one when it collides.
# NACRE_API_HOST_PORT=8080
# NACRE_MCP_HOST_PORT=8081
# NACRE_WEB_HOST_PORT=8082


# ── Data stores ──────────────────────────────────────────────────────────────

NACRE_PG_URL=postgres://nacre:nacre@postgres:5432/nacre
NACRE_QDRANT_URL=http://qdrant:6333
NACRE_REDIS_URL=redis://redis:6379/0
NACRE_PARSER_ENDPOINT=http://parser:8090

# Let the parser fetch from private and link-local addresses. Off by default:
# on, an authenticated tenant can point it at your cloud metadata endpoint.
# NACRE_PARSER_ALLOW_PRIVATE_URLS=true


# ── Embeddings — pick one ────────────────────────────────────────────────────
#
# These three describe what a **new** organization gets; `init` writes them into
# an `embedding_providers` row and everything afterwards reads that row. Editing
# them later does not move an organization that already exists — see
# docs/apple-silicon.md, "Changing the endpoint after init".
#
# NACRE_DEFAULT_EMBEDDING_DIM must match the model, or the index is built at the
# wrong width and every search misses.

# A) An embedder you run — Ollama, LM Studio, a TEI of your own.
#    `--profile minimal`, and on an M-series Mac this is the fast one: the model
#    runs natively on Metal. Ollama needs `OLLAMA_HOST=0.0.0.0:11434 ollama
#    serve` and `ollama pull bge-m3`.
# NACRE_DEFAULT_EMBEDDING_ENDPOINT=http://host.docker.internal:11434/v1
# NACRE_DEFAULT_EMBEDDING_MODEL=bge-m3
# NACRE_DEFAULT_EMBEDDING_DIM=1024

# B) The embedder in `--profile full` (Text Embeddings Inference).
#    amd64 only, so on arm64 it runs emulated and slowly.
# NACRE_DEFAULT_EMBEDDING_ENDPOINT=http://embedder:80
# NACRE_DEFAULT_EMBEDDING_MODEL=bge-m3
# NACRE_DEFAULT_EMBEDDING_DIM=1024

# C) A hosted vendor, through the adapter in `--profile hosted`.
#    **The text of your documents leaves your installation.** Vendors:
#    openai-compatible, cloudflare, google, voyage. There is no `anthropic` —
#    they publish no embeddings API. See docs/config.md, "The embedding adapter".
# NACRE_DEFAULT_EMBEDDING_ENDPOINT=http://embedding-adapter:8091
# NACRE_DEFAULT_EMBEDDING_MODEL=@cf/baai/bge-m3
# NACRE_DEFAULT_EMBEDDING_DIM=1024
#
#    The adapter's own routing and credentials. `NACRE_EMBED_ROUTES` is
#    `model=vendor`, comma-separated; the model must be the one above. Every
#    key also has a `_FILE` form that names a file, for a secret store.
# NACRE_EMBED_ROUTES=@cf/baai/bge-m3=cloudflare
# NACRE_EMBED_CLOUDFLARE_ACCOUNT=
# NACRE_EMBED_CLOUDFLARE_API_KEY=
# NACRE_EMBED_OPENAI_COMPATIBLE_ENDPOINT=https://api.openai.com/v1
# NACRE_EMBED_OPENAI_COMPATIBLE_API_KEY=
# NACRE_EMBED_GOOGLE_API_KEY=
# NACRE_EMBED_VOYAGE_API_KEY=
#
#    A tenant `POST /v1/embedding-providers` may name a public https embedder
#    or the configured default above; any other internal host is refused (an
#    SSRF guard, which matters where an org_admin is a customer). If you run a
#    *second* internal embedder a tenant should be allowed to use, list its
#    origins here, comma-separated. Empty is the safe default.
# NACRE_EMBED_ALLOWED_HOSTS=


# ── Reranking — off, or pick one ─────────────────────────────────────────────
#
# Reranking reorders an already-permitted candidate set; it changes which
# results come back, never how many. Off needs nothing.

NACRE_RERANKER_ENABLED=false
NACRE_RERANK_CANDIDATES=50

# A) The reranker in `--profile full` (Text Embeddings Inference, amd64 only).
# NACRE_RERANKER_ENDPOINT=http://reranker:80

# B) A hosted vendor, through the same adapter as embeddings above.
#    Vendors: cloudflare, cohere, jina, voyage. OpenAI, Anthropic and Google
#    publish no reranking API. One reranker per adapter — the request carries no
#    model name, so there is nothing to route on.
# NACRE_RERANKER_ENDPOINT=http://embedding-adapter:8091
# NACRE_RERANK_VENDOR=cloudflare
# NACRE_RERANK_MODEL=@cf/baai/bge-reranker-base
# NACRE_RERANK_CLOUDFLARE_ACCOUNT=
# NACRE_RERANK_CLOUDFLARE_API_KEY=
# NACRE_RERANK_COHERE_API_KEY=
# NACRE_RERANK_JINA_API_KEY=
# NACRE_RERANK_VOYAGE_API_KEY=


# ── Object storage ───────────────────────────────────────────────────────────
#
# Off by default: bytes are stored inline. Uploading a PDF requires it.
# All four together or none. `--profile full` starts a MinIO and creates the
# bucket; anything else is a bucket you create.

# NACRE_S3_ENDPOINT=http://minio:9000
# NACRE_S3_BUCKET=nacre
# NACRE_S3_ACCESS_KEY=minioadmin
# NACRE_S3_SECRET_KEY=minioadmin
# NACRE_S3_FORCE_PATH_STYLE=true


# ── Tokens and sign-in ───────────────────────────────────────────────────────

# A shared secret, or an Ed25519 key — one or the other, and setting both is
# refused. A key is what keeps the process that *verifies* tokens unable to mint
# them; `file://` only, and the public half is published at /.well-known/jwks.json.
NACRE_JWT_SECRET=development-only-not-a-secret-0123456789
# NACRE_JWT_PRIVATE_KEY_REF=file:///run/secrets/nacre-signing.pem
# Rotation: the old key stays accepted while tokens signed with it are alive.
# NACRE_JWT_SECRET_PREVIOUS=
# NACRE_JWT_PREVIOUS_KEY_REF=

# A second factor is offered only where there is a key to seal its secret with.
# Unset, the surface answers 404 and sign-in is unchanged — there is deliberately
# no mode that stores a TOTP secret in the clear. Back this up where you back up
# the signing key: losing it makes every enrolled authenticator useless, which is
# what the recovery codes issued at enrolment are for.
# Password recovery by email. Set as a group or not at all; unset, the routes are
# not mounted and the console shows no recovery link.
# NACRE_SMTP_URL=smtps://nacre%40example.com:secret@smtp.example.com:465
# NACRE_MAIL_FROM=Nacre <nacre@example.com>

# Base64 or hex, exactly 32 bytes. One variable and no file form: to keep the key
# out of the environment, read it from your secret store in the line that sets it
# — NACRE_2FA_KEY=$(cat /run/secrets/nacre_2fa.key).
#   openssl rand -base64 32
# NACRE_2FA_KEY=

NACRE_JWT_ISSUER=http://localhost:8080
NACRE_JWT_AUDIENCE=nacre

NACRE_ACCESS_TOKEN_TTL=900
NACRE_REFRESH_TOKEN_TTL=2592000

# Sign-in limits: per address, and per client. `NACRE_TRUST_PROXY` is how many
# proxies sit in front — 0 means the socket address decides, and neither default
# is safe behind an unknown number of hops.
NACRE_RATE_LOGIN_PER_15MIN=10
NACRE_RATE_LOGIN_SOURCE_PER_15MIN=60
NACRE_TRUST_PROXY=0


# ── MCP and OAuth ────────────────────────────────────────────────────────────

# Browser origins the MCP transport answers. Empty refuses every browser and no
# agent, which is the right default: an agent sends no Origin.
NACRE_MCP_ALLOWED_ORIGINS=

# Both deliberately unset. The transport derives its identifier from the `Host`
# each client used, and the discovery document names this installation's own API
# as the authorization server. Set them only when a proxy rewrites `Host`, or
# when an external provider issues the tokens.
# NACRE_MCP_CANONICAL_URL=
# NACRE_OAUTH_AUTHORIZATION_SERVER=
# NACRE_OAUTH_CONSENT_URL=


# ── Operations ───────────────────────────────────────────────────────────────

# /metrics is unauthenticated while this is empty. Set it in anything shared.
NACRE_METRICS_TOKEN=

# NACRE_LOG_LEVEL=info

# No trailing comments on these lines: `env_file` takes everything after `=` as
# the value, so `60  # seconds` is the string "60  # seconds" and the process
# refuses to start.

# Effective-principals cache, seconds.
NACRE_ACL_CACHE_TTL=60
# Seconds before a deleted document's vectors are reclaimed.
NACRE_GC_GRACE=60
# A worker's claim on a document, seconds, and how long a dead worker's document
# waits before another picks it up.
NACRE_INDEX_LEASE=900
NACRE_INDEX_MAX_ATTEMPTS=5
# Rollback window after a reindex replaces a collection, in days. Moving the
# pointer back is the cheap rollback and it works only while the old one exists.
NACRE_COLLECTION_RETENTION_DAYS=7
# recall@10 a new embedding model must reach against a layer's reference queries
# before a reindex will switch to it. 0 measures without blocking.
NACRE_REINDEX_MIN_RECALL=80

# Commercial modules. Empty on the open product.
NACRE_MODULES=

# Passed to the embedder and reranker containers, not read by Nacre. The
# airgapped profile sets it to 1 so they use pre-seeded weights and never reach
# the Hugging Face Hub.
# HF_HUB_OFFLINE=1
