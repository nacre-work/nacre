# The parser sidecar: bytes -> {text, blocks, metadata}.
#
# Python because that is where the document-parsing libraries are, and a
# sidecar rather than a library because it is the one component that runs
# untrusted input through a large C dependency tree. It holds no credentials
# and reaches no database — if it is compromised it has nothing to reach.
FROM python:3.13-slim
WORKDIR /app

# The one dependency, installed from the pinned manifest before the user
# drops privileges. Pure Python on purpose — see services/parser/app.py.
COPY services/parser/requirements.txt services/parser/requirements.txt
RUN pip install --no-cache-dir -r services/parser/requirements.txt

RUN adduser --system --group nacre
USER nacre

COPY --chown=nacre:nacre services/parser services/parser
EXPOSE 8090
CMD ["python", "-m", "services.parser"]
