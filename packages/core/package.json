{
  "name": "@nacre.work/core",
  "version": "0.23.3",
  "description": "Nacre core: data model, permission resolver, and shared types",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nacre-work/nacre.git",
    "directory": "packages/core"
  },
  "homepage": "https://nacre.work",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && node ./scripts/copy-migrations.mjs",
    "dev": "tsx watch index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@qdrant/js-client-rest": "^1.18.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "jose": "^6.2.7"
  },
  "keywords": [
    "nacre",
    "rag",
    "permissions",
    "access-control",
    "authorization",
    "vector-search",
    "self-hosted"
  ],
  "bugs": {
    "url": "https://github.com/nacre-work/nacre/issues"
  },
  "author": "Nacre",
  "engines": {
    "node": ">=22"
  }
