{
  "name": "@nacre.work/core",
  "version": "0.41.2",
  "description": "Nacre core: data model, permission resolver, and shared types",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nacre-work/nacre.git",
    "directory": "packages/core"
  },
  "homepage": "https://nacre.work",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && node ./scripts/copy-migrations.mjs",
    "dev": "tsx watch index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@qdrant/js-client-rest": "^1.20.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "jose": "^6.2.13"
  },
  "keywords": [
    "nacre",
    "rag",
    "permissions",
    "access-control",
    "authorization",
    "vector-search",
    "self-hosted"
  ],
  "bugs": {
    "url": "https://github.com/nacre-work/nacre/issues"
  },
  "author": "Nacre",
  "engines": {
    "node": ">=24"
  }
}
