{
  "name": "@nacre.work/mcp",
  "version": "0.0.0",
  "description": "MCP server: Streamable HTTP and STDIO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nacre-work/nacre.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://nacre.work",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nacre-mcp": "./dist/stdio-main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@nacre.work/api": "workspace:*",
    "@nacre.work/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  }
}
