{
  "name": "@nacre.work/sdk",
  "version": "0.5.8",
  "description": "TypeScript client for the Nacre REST API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nacre-work/nacre.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://nacre.work",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "nacre",
    "sdk",
    "client",
    "rag",
    "permissions",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/nacre-work/nacre/issues"
  },
  "author": "Nacre",
  "engines": {
    "node": ">=22"
  }
}
