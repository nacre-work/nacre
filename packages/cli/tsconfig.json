{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  // Node only, unlike the SDK it wraps: this is a terminal program, and the
  // reason the SDK forbids itself Node globals — the admin UI bundles it for a
  // browser — does not apply to anything here.
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/__tests__/**"
  ],
  "references": [
    {
      "path": "../sdk"
    }
  ]
}
