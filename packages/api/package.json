{
  "name": "@nacre.work/api",
  "version": "0.25.1",
  "description": "Nacre REST API and authorization service",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nacre-work/nacre.git",
    "directory": "packages/api"
  },
  "homepage": "https://nacre.work",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
