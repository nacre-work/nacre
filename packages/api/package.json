  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.3"
  },
  "keywords": [
    "nacre",
    "rest",
    "api",
    "permissions",
    "access-control",
    "rag",
    "self-hosted"
  ],
  "bugs": {
    "url": "https://github.com/nacre-work/nacre/issues"
  },
  "author": "Nacre",
  "engines": {
    "node": ">=22"
