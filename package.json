{
  "name": "nacre",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @nacre.work/api dev",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm test:unit && pnpm test:acl",
    "test:unit": "vitest run --dir packages",
    "test:acl": "vitest run --dir packages/core/authz/__tests__",
    "test:acl:property": "vitest run packages/core/authz/__tests__/property.test.ts",
    "migrate": "node packages/core/dist/migrate.js"
  }
}
