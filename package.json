{
  "name": "nacre",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @nacre.work/api dev",
    "migrate": "tsx scripts/migrate.ts",
    "lint": "eslint .",
    "lint:openapi": "redocly lint docs/openapi.yaml",
    "lint:compose": "node scripts/check-compose.mjs",
    "lint:workflows": "node scripts/check-workflows.mjs",
    "lint:config": "node scripts/check-config-docs.mjs",
    "lint:entrypoints": "node scripts/check-entrypoints.mjs",
    "lint:acl-groups": "node scripts/check-acl-groups.mjs",
    "lint:publish": "node scripts/check-publish.mjs",
    "lint:upgrading": "node scripts/check-upgrading.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm test:unit && pnpm test:acl",
    "test:unit": "vitest run --project unit",
    "test:acl": "vitest run --project acl",
    "test:acl:group": "node scripts/acl-group.mjs",
    "test:acl:property": "vitest run --project acl property",
    "authz:pending": "tsx scripts/authz-pending.ts",
    "sync:legal": "node scripts/sync-package-legal.mjs",
    "lint:legal": "node scripts/sync-package-legal.mjs --check",
    "lint:admin-gate": "node scripts/check-admin-gate.mjs",
    "lint:admin-classes": "node scripts/check-admin-classes.mjs",
    "lint:admin-layout": "node scripts/check-admin-layout.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:mail-palette": "node scripts/check-mail-palette.mjs",
    "lint:demo-seed": "node scripts/check-demo-seed.mjs",
    "preview:mail": "node scripts/mail-preview.mjs",
    "lint:stored-error": "node scripts/check-stored-error.mjs",
    "lint:email-rule": "node scripts/check-email-rule.mjs",
    "lint:console-extensions": "node scripts/check-console-extensions.mjs",
    "lint:admin-ids": "node scripts/check-id-fields.mjs",
    "lint:collection-config": "node scripts/check-collection-config.mjs",
    "lint:password": "node scripts/check-password-generator.mjs",
    "lint:me-credentials": "node scripts/check-me-credentials.mjs",
    "lint:images": "node scripts/check-images.mjs",
    "lint:nginx": "node scripts/check-nginx-proxy.mjs",
    "lint:endpoint-errors": "node scripts/check-endpoint-errors.mjs",
    "lint:sparse": "node scripts/check-sparse-branch.mjs",
    "lint:embed-batch": "node scripts/check-embed-batch.mjs",
    "lint:test-plan-range": "node scripts/check-test-plan-range.mjs",
    "lint:test-clock": "node scripts/check-test-clock.mjs",
    "lint:image-packages": "node scripts/check-image-packages.mjs",
    "lint:published": "node scripts/check-published-manifests.mjs",
    "lint:audit-target": "node scripts/check-audit-target.mjs",
    "lint:platform-admin-target": "node scripts/check-platform-admin-target.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.43.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.3",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
