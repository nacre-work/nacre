{
  "name": "nacre",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @nacre.work/api dev",
    "lint": "eslint .",
    "lint:openapi": "redocly lint docs/openapi.yaml",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm test:unit && pnpm test:acl",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:acl": "vitest run --project acl",
    "test:acl:group": "node scripts/acl-group.mjs",
    "test:acl:property": "vitest run --project acl property",
    "authz:pending": "tsx scripts/authz-pending.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.43.2",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
